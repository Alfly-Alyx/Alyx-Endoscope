<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ClinkCameraDemo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.ClinkCameraDemo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Alyx.Atelier" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFFF5A00</item>
        <item name="colorPrimaryVariant">#FFE85200</item>
        <item name="colorSecondary">#FFFF5A00</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF182027</item>
        <item name="android:colorBackground">#FFF4F6F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Alyx.Workshop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFFF6B00</item>
        <item name="colorPrimaryVariant">#FFCB4E00</item>
        <item name="colorSecondary">#FFFF6B00</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF292725</item>
        <item name="android:colorBackground">#FFFFFBF7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ClinkCameraDemo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.ClinkCameraDemo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Camera2TopButtonStyle">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="AlyxCircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="SplashActivityStyle" parent="Theme.AppCompat.NoActionBar">
        <!-- The form background color is transparent -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- The form has no border -->
        <item name="android:windowFrame">@null</item>
        <!-- The form does not contain a title bar -->
        <item name="android:windowNoTitle">true</item>
        <!-- Window suspension -->
        <item name="android:windowIsFloating">false</item>
        <!-- Remove redundant shadows when customizing TitleBar-->
        <item name="android:windowContentOverlay">@null</item>
        <!-- Do not allow form background to be dimmed -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Disable the preview animation of the window -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <style name="camera2_anim_down_to_top" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/push_bottom_in</item>
        <item name="android:windowExitAnimation">@anim/push_bottom_out</item>
    </style>
</resources>
