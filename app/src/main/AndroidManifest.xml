<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Il est préférable d'utiliser Scoped Storage plutôt que d'accéder librement aux fichiers externes -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- Utilisation des nouvelles API de stockage (Scoped Storage) à partir d'Android 10 -->

    <uses-feature android:name="android.hardware.camera"/>
    <uses-feature android:name="android.hardware.camera.autofocus"/>

    <application
        android:name="com.jiangdg.demo.DemoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ClinkCameraDemo"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true">

        <!-- Activité principale -->
        <activity
            android:name="com.jiangdg.demo.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ClinkCameraDemo.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.jiangdg.demo.GalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.jiangdg.demo.MediaViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
